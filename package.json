{
  "name": "war3-model-viewer",
  "version": "1.0.0",
  "description": "魔兽争霸3 3D模型网页查看器",
  "scripts": {
    "gen-index": "node scripts/generate-models-index.js",
    "gen-motions": "node scripts/generate-builtin-vmds.js",
    "merge-wave": "node scripts/merge-wave-leftarm.mjs",
    "dev": "node scripts/generate-models-index.js && webpack serve --mode=development",
    "build": "node scripts/generate-models-index.js && webpack --mode=production",
    "preview": "webpack serve --mode=production",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@yohawing/three-mmd-loader": "^0.8.1",
    "events": "^3.3.0",
    "mdx-m3-viewer": "^5.12.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.8",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
